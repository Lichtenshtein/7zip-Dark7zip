+{
+	*password = NULL;
+	RINOK(CheckBreak2())
+
+	if (PasswordReader) {
+		ClosePercents();
+		Password = "";
+		PasswordBruteforced = false;
+		//RINOK(PasswordReader->GetNextPassword(&Password));
